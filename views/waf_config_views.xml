<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_waf_config_form" model="ir.ui.view">
        <field name="name">waf.config.form</field>
        <field name="model">waf.config</field>
        <field name="arch" type="xml">
            <form string="Konfigurasi WAF">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="active"/>
                        <field name="block_mode"/>
                    </group>
                    <notebook>
                        <page string="Deteksi Ancaman">
                            <group>
                                <group string="Kategori Deteksi">
                                    <field name="enable_sql_injection_detection"/>
                                    <field name="enable_xss_detection"/>
                                    <field name="enable_rce_detection"/>
                                    <field name="enable_path_traversal_detection"/>
                                </group>
                                <group string="Path Dikecualikan">
                                    <field name="excluded_paths" nolabel="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Rate Limiting &amp; Brute Force">
                            <group>
                                <group string="Rate Limiting">
                                    <field name="enable_rate_limiting"/>
                                    <field name="rate_limit_requests"
                                           attrs="{'invisible': [('enable_rate_limiting','=',False)]}"/>
                                    <field name="rate_limit_window"
                                           attrs="{'invisible': [('enable_rate_limiting','=',False)]}"/>
                                </group>
                                <group string="Brute Force Login">
                                    <field name="enable_brute_force_protection"/>
                                    <field name="brute_force_max_attempts"
                                           attrs="{'invisible': [('enable_brute_force_protection','=',False)]}"/>
                                    <field name="brute_force_window"
                                           attrs="{'invisible': [('enable_brute_force_protection','=',False)]}"/>
                                </group>
                            </group>
                            <group string="Auto Ban">
                                <field name="auto_ban_enabled"/>
                                <field name="auto_ban_threshold"
                                       attrs="{'invisible': [('auto_ban_enabled','=',False)]}"/>
                                <field name="auto_ban_duration_hours"
                                       attrs="{'invisible': [('auto_ban_enabled','=',False)]}"/>
                            </group>
                        </page>
                        <page string="Security Headers">
                            <group>
                                <field name="enable_security_headers"/>
                                <field name="enable_hsts"/>
                                <field name="enable_csp"/>
                                <field name="csp_policy" attrs="{'invisible': [('enable_csp','=',False)]}"/>
                                <field name="enable_x_frame_options"/>
                                <field name="x_frame_options_value"
                                       attrs="{'invisible': [('enable_x_frame_options','=',False)]}"/>
                            </group>
                        </page>
                        <page string="Alerting &amp; Log">
                            <group>
                                <group string="Email Alert">
                                    <field name="enable_email_alert"/>
                                    <field name="alert_email_to"
                                           attrs="{'invisible': [('enable_email_alert','=',False)]}"/>
                                </group>
                                <group string="Telegram Alert">
                                    <field name="enable_telegram_alert"/>
                                    <field name="telegram_bot_token"
                                           attrs="{'invisible': [('enable_telegram_alert','=',False)]}"/>
                                    <field name="telegram_chat_id"
                                           attrs="{'invisible': [('enable_telegram_alert','=',False)]}"/>
                                </group>
                            </group>
                            <group>
                                <field name="alert_min_severity"/>
                                <field name="log_retention_days"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_waf_config_list" model="ir.ui.view">
        <field name="name">waf.config.list</field>
        <field name="model">waf.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active"/>
                <field name="block_mode"/>
            </tree>
        </field>
    </record>

    <record id="action_waf_config" model="ir.actions.act_window">
        <field name="name">Konfigurasi WAF</field>
        <field name="res_model">waf.config</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
